{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bobix",
  "version": "../package.json",
  "identifier": "dev.bobix.app",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDOENCNjA1MTFFQjJCMkYKUldRdksrc1JCYmFNYk1hNXg1MHlaeGJURVYxTEJWRVJRN0YycGVsbVFOOXRFV09wb2NmbDc2M1AK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/baonguyen-agilityio/bobix/releases/latest/download/latest.json",
        "https://github.com/baonguyen-agilityio/bobix/releases/download/test-channel/test.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "publisher": "Bobix contributors",
    "category": "DeveloperTool",
    "shortDescription": "A personal assistant for working well with Claude Code.",
    "longDescription": "A personal assistant for working well with Claude Code: a pet per session on your desktop, approvals from the pet or a notification, usage per session, and a skills audit.",
    "homepage": "https://github.com/baonguyen-agilityio/bobix",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
