<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Debug builds only: adb can seed a computer and deliver a sealed notice without Firebase (see DebugPush.kt). -->
        <activity android:name=".debug.WidgetPreview" android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name=".debug.DebugPush" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
