<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same keychain group as the app (it holds `box`) and the App Group the receive state lives in. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.bobix.phone.keys</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(BOBIX_APP_GROUP)</string>
	</array>
</dict>
</plist>
