<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keychain group the app shares its `auth` and `box` keys with its extensions (the notification service
	     extension, the widgets): every one of them lists the same group. The prefix is the Apple team. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.bobix.phone.keys</string>
	</array>
</dict>
</plist>
