<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keychain group the app shares its `auth` and `box` keys with its extensions (the notification service
	     extension, the widgets): every one of them lists the same group. The prefix is the Apple team. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.bobix.phone.keys</string>
	</array>
	<!-- The App Group holds the receive state and the "Hide details" switch, which the app and the notification service
	     extension (two processes) both read and write. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(BOBIX_APP_GROUP)</string>
	</array>
	<!-- Push through APNs directly. Xcode replaces `development` with `production` for an App Store or TestFlight build. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
