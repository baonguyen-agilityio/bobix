<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Two keychain groups. `dev.bobix.phone.keys` holds `box` and is listed by the notification service extension and
	     the widgets too (a notice opens with `box` alone). `dev.bobix.phone.app-keys` holds `auth` and the signing key
	     and is listed by the app only, so no extension can get a reference to them. The prefix is the Apple team. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.bobix.phone.app-keys</string>
		<string>$(AppIdentifierPrefix)dev.bobix.phone.keys</string>
	</array>
	<!-- The App Group holds the receive state and the "Hide details" switch, which the app and the notification service
	     extension (two processes) both read and write. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(BOBIX_APP_GROUP)</string>
	</array>
	<!-- Push through APNs directly. Xcode replaces `development` with `production` for an App Store or TestFlight build. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
