// A build for TestFlight: the Release build of the phone app, but with the dev flavor (it accepts `relay --dev` on a private
// LAN address). The software key is never defined here, so the build uses the real Secure Enclave key and Face ID.
// What Release.xcconfig includes, with the Pods settings of this configuration (a copy of Release for CocoaPods).
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release-testflight.xcconfig"
#include "Generated.xcconfig"

// Per-developer settings (the Apple team, signing): copy Local.xcconfig.example to Local.xcconfig, which git ignores.
#include? "Local.xcconfig"

// The Dart defines Flutter hands to the Xcode build, as comma-separated base64: BOBIX_FLAVOR=dev
DART_DEFINES=Qk9CSVhfRkxBVk9SPWRldg==
